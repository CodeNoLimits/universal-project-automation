      "id": "parse-message",
      "name": "Parse WhatsApp/Telegram Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300],
      "code": "const body = $input.item.json.Body || $input.item.json.message?.text;\nconst from = $input.item.json.From || $input.item.json.message?.from?.id;\n\n// Parse command from message\nconst commands = {\n  'deploy': { action: 'deploy', project: null },\n  'analyze': { action: 'competitor_analysis', project: null },\n  'optimize': { action: 'image_optimization', project: null },\n  'validate': { action: 'validation', project: null },\n  'screenshot': { action: 'screenshot', project: null },\n  'benchmark': { action: 'benchmark', project: null },\n  'all': { action: 'full_automation', project: null }\n};\n\nlet parsed = { action: 'unknown', project: null, raw: body };\n\nfor (const [cmd, config] of Object.entries(commands)) {\n  if (body.toLowerCase().includes(cmd)) {\n    parsed = { ...config, raw: body };\n    break;\n  }\n}\n\n// Extract project name if mentioned\nconst projectKeywords = {\n  'barukh': 'barukh-sagit-jewelry',\n  'sagit': 'barukh-sagit-jewelry',\n  'bijoux': 'barukh-sagit-jewelry',\n  'esther': 'esther-ifra-breslev',\n  'ifra': 'esther-ifra-breslev',\n  'breslev': 'esther-ifra-breslev',\n  'keren': 'keren-rabbi-israel',\n  'dreamnova': 'dreamnova-v2',\n  'document': 'dreamnova-v2',\n  'rabbi': 'rabbi-nachman-rag',\n  'nachman': 'rabbi-nachman-rag',\n  'solar': 'primapac-kavkom',\n  'primapac': 'primapac-kavkom',\n  'terramind': 'terramind-betterhelp-competitor',\n  'therapy': 'terramind-betterhelp-competitor',\n  'pizza': 'pizza-plus-social-automation'\n};\n\nfor (const [keyword, projectId] of Object.entries(projectKeywords)) {\n  if (body.toLowerCase().includes(keyword)) {\n    parsed.project = projectId;\n    break;\n  }\n}\n\nreturn { json: parsed };"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.action}}",
              "operation": "equals",
              "value2": "competitor_analysis"
            }
          ]
        }
